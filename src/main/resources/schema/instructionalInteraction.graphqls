
type InstructionalInteraction{
    "Control interactions specific to instructional systems"
    instructionalType: InstructionalTypeEnum
    trainingFacilityId : String
}

input InstructionalInteractionInput{
    "Control interactions specific to instructional systems"
    instructionalType: InstructionalTypeEnum
    trainingFacilityId : String
}

enum InstructionalTypeEnum{
    START
    STOP
    PAUSE
    RESUME
}
