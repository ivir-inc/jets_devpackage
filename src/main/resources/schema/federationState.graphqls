type FederationState{
    itemIdentifier: ItemIdentifier
    "Indicator of the current state of the federation."
    state: FederationStateEnum
}

input FederationStateInput{
    itemIdentifier: ItemIdentifierInput
    "Indicator of the current state of the federation."
    state: FederationStateEnum
}

enum FederationStateEnum{
    PENDING_START
    RUNNING
    STOPPED
    PAUSED
    SAVING
    RESUMING
}